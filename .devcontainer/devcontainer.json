{
  "name": "APM lab",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --user 'apm-cli==0.35.1' && apm --version",
  "remoteEnv": {
    "LAB": "${containerWorkspaceFolder}"
  },
  "customizations": {
    "vscode": {
      "extensions": ["GitHub.copilot", "GitHub.copilot-chat"]
    }
  }
}
